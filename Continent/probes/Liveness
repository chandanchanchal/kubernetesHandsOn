apiVersion: apps/v1
kind: Deployment
metadata:
  name: flight-status-api
spec:
  replicas: 1
  selector:
    matchLabels:
      app: flight-status
  template:
    metadata:
      labels:
        app: flight-status
    spec:
      containers:
      - name: flight-status-api
        image: chandanchanchal/flight-status-api:v1
        ports:
        - containerPort: 8080
        livenessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 10  # Wait 10 sec before first check
          periodSeconds: 5        # Check every 5 sec
        readinessProbe:
          httpGet:
            path: /ready
            port: 8080
          initialDelaySeconds: 3
          periodSeconds: 3
        startupProbe:
          httpGet:
            path: /ready
            port: 8080
          failureThreshold: 10  # Allow 10 attempts (10 x 3 sec = 30 sec max)
          periodSeconds: 3
---
apiVersion: v1
kind: Service
metadata:
  name: flight-status-service
spec:
  selector:
    app: flight-status
  ports:
    - protocol: TCP
      port: 80
      targetPort: 8080
